# Copia questo file in .env.local e compila i valori.
# Nessuno di questi è un segreto: il projectId Sanity è pubblico e il
# dataset è in sola lettura. Stanno qui per non doverli cercare nel
# codice quando cambiano.

# Indirizzo pubblico del sito: serve a rendere assoluti i link della
# sitemap e le immagini di anteprima delle condivisioni social.
NEXT_PUBLIC_SITE_URL=https://sharonbertoncello.com

# Progetto Sanity (https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=gdqr6s88
NEXT_PUBLIC_SANITY_DATASET=production
